PORT=4000
# Database in Docker (see docker-compose.yml). Docker Compose reads the POSTGRES_* values from this file too.
POSTGRES_USER=dukasmart
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=dukasmart
POSTGRES_PORT=5433
# Must match the four values above
DATABASE_URL=postgres://dukasmart:change-me-strong-db-password@localhost:5433/dukasmart
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_JWT_SECRET=change-me-to-another-long-random-string
TRIAL_DAYS=7
# Comma separated list of origins allowed to call the API from a browser (the admin panel)
CORS_ORIGINS=http://localhost:5173

# M-Pesa Daraja (https://developer.safaricom.co.ke)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
# CustomerPayBillOnline for a paybill, CustomerBuyGoodsOnline for a till
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# For a till, PartyB is the till number while MPESA_SHORTCODE is the store number. Leave empty for paybill.
MPESA_PARTY_B=
# Public HTTPS base URL of this API (use ngrok while developing)
PUBLIC_BASE_URL=https://your-ngrok-url.ngrok-free.app
# Random string added to the callback URL so strangers cannot post fake callbacks
MPESA_CALLBACK_SECRET=change-me-random-string
