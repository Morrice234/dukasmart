{
  "expo": {
    "name": "DukaSmart",
    "slug": "dukasmart",
    "scheme": "dukasmart",
    "version": "1.0.7",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "ke.dukasmart.app",
      "softwareKeyboardLayoutMode": "pan",
      "versionCode": 8,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F7B4A"
      }
    },
    "ios": {
      "bundleIdentifier": "ke.dukasmart.app"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "DukaSmart uses the camera to scan product barcodes and QR codes.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F7B4A"
    }
  }
}
